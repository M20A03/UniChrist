@{
    ViewData["Title"] = "UniChrist Autonomous Campus Operating System";
}

<!-- TAB 1: FACULTY PRESENCE & SCHEDULE ENGINE -->
<section id="tab-faculty" class="tab-panel active">
    <div class="editorial-card">
        <div class="card-title-bar">
            <h2>Faculty Schedule &amp; Spatial Presence Engine</h2>
            <span class="meta-code">RULE: TIMETABLE_INDEX_V2 &bull; ZERO_BIOMETRIC_PRIVACY</span>
        </div>
        <p style="font-size: 13px; color: var(--text-secondary); margin-bottom: 20px;">
            Derived algorithmically by evaluating the university institutional timetable against wall-clock time. If active lecture period matches, current classroom is assigned. Otherwise, direct cabin routing is displayed.
        </p>

        <!-- Time simulation bar -->
        <div style="background: var(--bg-surface-elevated); border: 1px solid var(--border-strong); padding: 14px; margin-bottom: 20px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px;">
            <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                <span style="font-family: var(--font-mono); font-size: 11px; color: var(--text-secondary);">TIME OVERRIDE SIMULATOR:</span>
                <button class="btn-editorial" onclick="setSimulatedTime('MONDAY', '10:00:00')">Mon 10:00 AM (Lecture)</button>
                <button class="btn-editorial" onclick="setSimulatedTime('MONDAY', '12:00:00')">Mon 12:00 PM (Lab)</button>
                <button class="btn-editorial" onclick="setSimulatedTime('MONDAY', '15:30:00')">Mon 03:30 PM (Cabin)</button>
                <button class="btn-editorial" onclick="setSimulatedTime('', '')">Clock Sync</button>
            </div>
            <button class="btn-editorial btn-gold" onclick="triggerOverride(3, 'IN_MEETING')">Simulate Meeting Override</button>
        </div>

        <table class="dense-table">
            <thead>
                <tr>
                    <th>Faculty Name</th>
                    <th>Department</th>
                    <th>Designation</th>
                    <th>Status Vector</th>
                    <th>Calculated Location</th>
                    <th>Consultation Window</th>
                </tr>
            </thead>
            <tbody id="facultyTableBody">
                <!-- Populated via C# .NET API -->
            </tbody>
        </table>
    </div>
</section>

<!-- TAB 2: CAFETERIA & YOUPI-PG PAYMENTS -->
<section id="tab-cafeteria" class="tab-panel">
    <div class="grid-2col">
        <div class="editorial-card">
            <div class="card-title-bar">
                <h2>Campus Kitchen &amp; Inventory Manifest</h2>
                <span class="meta-code">REDISJSON_STOCK_SYNC</span>
            </div>
            <div id="cafeteriaItemsList">
                <!-- Populated via C# .NET API -->
            </div>
        </div>

        <div class="editorial-card">
            <div class="card-title-bar">
                <h2>YouPI-PG Checkout &amp; Token Generator</h2>
                <span class="meta-code">HMAC_SHA256_SECURED</span>
            </div>
            <div id="orderTray" style="min-height: 120px; margin-bottom: 20px;">
                <p style="font-family: var(--font-mono); font-size: 12px; color: var(--text-muted);">TRAY VACANT. Select item manifest from inventory.</p>
            </div>
            <div style="border-top: 1px solid var(--border-subtle); padding-top: 16px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: baseline;">
                <span style="font-family: var(--font-mono); font-size: 12px;">GROSS SETTLEMENT:</span>
                <strong id="trayTotal" style="font-family: var(--font-mono); font-size: 20px; color: var(--accent-gold);">₹0.00</strong>
            </div>
            <button class="btn-editorial btn-gold" style="width: 100%; padding: 12px;" onclick="executeYouPiPayment()">
                Dispatch Order via YouPI-PG Gateway
            </button>

            <div id="tokenReceipt" style="display: none; margin-top: 24px; padding: 20px; border: 1px solid var(--accent-gold); background: var(--bg-primary); text-align: center;">
                <div style="font-family: var(--font-mono); font-size: 11px; color: var(--accent-gold); letter-spacing: 1px;">SETTLED TRANSACTION TOKEN</div>
                <div id="receiptToken" style="font-family: var(--font-serif); font-size: 44px; color: #FFFFFF; margin: 10px 0;">#---</div>
                <div id="receiptMeta" style="font-family: var(--font-mono); font-size: 11px; color: var(--text-secondary);">VERIFIED</div>
            </div>
        </div>
    </div>
</section>

<!-- TAB 3: SLA GRIEVANCE AUDIT -->
<section id="tab-grievances" class="tab-panel">
    <div class="grid-2col">
        <div class="editorial-card">
            <div class="card-title-bar">
                <h2>Cryptographic Grievance Registration</h2>
                <span class="meta-code">CLAMAV_SANITIZED</span>
            </div>
            <form id="grievanceForm" onsubmit="submitGrievance(event)">
                <label style="font-family: var(--font-mono); font-size: 11px; color: var(--text-secondary); display: block; margin-bottom: 6px;">CATEGORY CLASSIFICATION</label>
                <select id="gCategory" class="form-input">
                    <option value="CAMPUS_WIFI">Campus Wi-Fi &amp; Internet Mesh</option>
                    <option value="CLASSROOM_INFRASTRUCTURE">Lecture Theatre Equipment</option>
                    <option value="LAB_EQUIPMENT">High-Performance Lab Hardware</option>
                    <option value="CANTEEN_HYGIENE">Cafeteria Quality Control</option>
                    <option value="WASHROOM_MAINTENANCE">Facility Sanitation</option>
                </select>

                <label style="font-family: var(--font-mono); font-size: 11px; color: var(--text-secondary); display: block; margin-bottom: 6px;">INCIDENT SUMMARY</label>
                <input type="text" id="gSubject" class="form-input" placeholder="Concise statement of failure" required>

                <label style="font-family: var(--font-mono); font-size: 11px; color: var(--text-secondary); display: block; margin-bottom: 6px;">SPECIFICATION &amp; LOCATION</label>
                <textarea id="gDesc" class="form-input" rows="3" placeholder="Exact room identifier and workstation number" required></textarea>

                <button type="submit" class="btn-editorial btn-gold" style="width: 100%;">
                    Sign &amp; File Grievance Ticket
                </button>
            </form>
        </div>

        <div class="editorial-card">
            <div class="card-title-bar">
                <h2>Immutable SLA Audit Ledger</h2>
                <span class="meta-code">STIX_2.1_VERIFIED</span>
            </div>
            <table class="dense-table">
                <thead>
                    <tr>
                        <th>Ticket</th>
                        <th>Category</th>
                        <th>Incident</th>
                        <th>SLA State</th>
                        <th>Logged</th>
                    </tr>
                </thead>
                <tbody id="grievanceTableBody">
                    <!-- Populated via C# .NET API -->
                </tbody>
            </table>
        </div>
    </div>
</section>

<!-- TAB 4: SMART PARKING TELEMETRY -->
<section id="tab-parking" class="tab-panel">
    <div class="editorial-card">
        <div class="card-title-bar">
            <h2>Smart Parking &amp; EV Charging Telemetry</h2>
            <span class="meta-code">REDIS_PUB_SUB_STREAM</span>
        </div>
        <p style="font-size: 12px; color: var(--text-secondary); margin-bottom: 16px;">
            Click any slot below to simulate automated gate/barrier sensor toggle. State is persisted in MySQL and streamed.
        </p>
        <div class="grid-4col" id="parkingGrid">
            <!-- Populated via C# .NET API -->
        </div>
    </div>
</section>

<!-- TAB 5: LIBRARY OPAC CATALOG -->
<section id="tab-library" class="tab-panel">
    <div class="editorial-card">
        <div class="card-title-bar">
            <h2>Centralized University Library OPAC</h2>
            <span class="meta-code">REDISEARCH_INDEXED</span>
        </div>
        <div style="display: flex; gap: 12px; margin-bottom: 20px;">
            <input type="text" id="bookSearchInput" class="form-input" style="margin-bottom: 0;" placeholder="Search by title, author, or ISBN (e.g. Navathe, Silberschatz, Database)..." onkeyup="if(event.key==='Enter') searchLibrary();">
            <button class="btn-editorial btn-gold" onclick="searchLibrary()">Search Catalog</button>
        </div>
        <div id="booksListContainer">
            <!-- Populated via C# .NET API -->
        </div>
    </div>
</section>

<!-- TAB 6: DEVSECOPS & OMNIROUTE INFERENCE -->
<section id="tab-infrastructure" class="tab-panel">
    <div class="editorial-card">
        <div class="card-title-bar">
            <h2>DevSecOps Posture &amp; OmniRoute AI Routing</h2>
            <span class="meta-code">COOLIFY_VERCEL_PIPELINE</span>
        </div>
        
        <div class="grid-2col" style="margin-bottom: 24px;">
            <div style="background: var(--bg-surface-elevated); padding: 18px; border: 1px solid var(--border-strong);">
                <h3 style="font-family: var(--font-serif); font-size: 15px; color: var(--accent-gold); margin-bottom: 12px;">Active Security Protocols</h3>
                <ul style="font-family: var(--font-mono); font-size: 12px; color: var(--text-secondary); list-style: none; line-height: 1.8;">
                    <li>&bull; <strong style="color: var(--text-primary);">Sherlock AI:</strong> Continuous vulnerability surface inspection (0 CVEs)</li>
                    <li>&bull; <strong style="color: var(--text-primary);">ClamAV Daemon:</strong> Active upload sanitization hook</li>
                    <li>&bull; <strong style="color: var(--text-primary);">STIX 2.1:</strong> Standardized Threat Observable serialization</li>
                    <li>&bull; <strong style="color: var(--text-primary);">Nginx Ingress:</strong> CSP, HSTS, X-Frame-Options DENY, Rate-Limiting</li>
                    <li>&bull; <strong style="color: var(--text-primary);">Sentry Tracing:</strong> Zero unhandled runtime exceptions</li>
                </ul>
            </div>

            <div style="background: var(--bg-surface-elevated); padding: 18px; border: 1px solid var(--border-strong);">
                <h3 style="font-family: var(--font-serif); font-size: 15px; color: var(--accent-gold); margin-bottom: 12px;">OmniRoute Free Inference Node Mesh</h3>
                <ul style="font-family: var(--font-mono); font-size: 12px; color: var(--text-secondary); list-style: none; line-height: 1.8;">
                    <li>&bull; <strong style="color: var(--text-primary);">Lightning.ai Studios:</strong> Cloud GPU L4 (Active Primary)</li>
                    <li>&bull; <strong style="color: var(--text-primary);">Hugging Face Spaces:</strong> T4 Community Endpoint (Standby)</li>
                    <li>&bull; <strong style="color: var(--text-primary);">Saturn Cloud Community:</strong> Data Plane Cluster</li>
                    <li>&bull; <strong style="color: var(--text-primary);">Kaggle / Colab Bridge:</strong> Async Fallback Node</li>
                </ul>
            </div>
        </div>

        <div style="background: var(--bg-primary); border: 1px solid var(--border-strong); padding: 18px;">
            <h3 style="font-family: var(--font-serif); font-size: 15px; margin-bottom: 12px;">Test OmniRoute Model Dispatcher</h3>
            <div style="display: flex; gap: 12px;">
                <input type="text" id="omniPrompt" class="form-input" style="margin-bottom: 0;" placeholder="Query schedule engine or campus service via zero-cost LLM route..." value="Where is Dr Hemanth K S right now?">
                <button class="btn-editorial btn-gold" onclick="queryOmniRoute()">Dispatch Prompt</button>
            </div>
            <div id="omniResponse" style="margin-top: 14px; font-family: var(--font-mono); font-size: 12px; color: var(--accent-gold);">
                Route Ready.
            </div>
        </div>
    </div>
</section>
