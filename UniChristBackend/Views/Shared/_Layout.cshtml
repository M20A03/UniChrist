<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>UniChrist | Autonomous Campus Operating & Intelligence System</title>
    <!-- Authentic Typography: Cinzel Serif, Space Grotesk, JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/editorial.css" />
</head>
<body>
    <!-- Institutional Master Header -->
    <header class="site-header">
        <div class="brand-wrapper">
            <div class="brand-crest">CU</div>
            <div class="brand-text">
                <h1>CHRIST (Deemed to be University)</h1>
                <p>UniChrist Autonomous Campus Operating System &bull; Bangalore Yeshwanthpur</p>
            </div>
        </div>
        <div class="system-badges">
            <a href="/swagger" target="_blank" class="telemetry-pill" style="text-decoration: none;">
                <span class="indicator-dot"></span>
                <span>OPENAPI / SWAGGER UI</span>
            </a>
            <div class="telemetry-pill">
                <span>C# .NET 8 MVC CORE</span>
            </div>
            <div class="telemetry-pill">
                <span>MYSQL 8.0 &bull; BCNF</span>
            </div>
        </div>
    </header>

    <!-- Strict Functional Navigation Strip -->
    <nav class="nav-strip">
        <button class="nav-link active" onclick="activateTab('tab-faculty', this)">Faculty Schedule Engine</button>
        <button class="nav-link" onclick="activateTab('tab-cafeteria', this)">Cafeteria &amp; YouPI-PG</button>
        <button class="nav-link" onclick="activateTab('tab-grievances', this)">SLA Grievance Audit</button>
        <button class="nav-link" onclick="activateTab('tab-parking', this)">Smart Parking Telemetry</button>
        <button class="nav-link" onclick="activateTab('tab-library', this)">Library OPAC Catalog</button>
        <button class="nav-link" onclick="activateTab('tab-infrastructure', this)">DevSecOps &amp; Inference</button>
    </nav>

    <!-- Main View Workspace -->
    <main class="container">
        @RenderBody()
    </main>

    <!-- Institutional Footer -->
    <footer class="site-footer">
        <div>
            CHRIST (Deemed to be University) &bull; Department of Computer Science &bull; BCA381-4 DBMS
        </div>
        <div>
            Backend: ASP.NET Core (.NET 8) &bull; Persistence: MySQL 8.0 &bull; Security: CIS / Trail of Bits &bull; Payment: YouPI-PG
        </div>
    </footer>

    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
