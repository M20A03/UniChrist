<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="UniChrist.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:UniChrist.Mobile"
    Title="UniChrist Portal"
    BackgroundColor="#080C14"
    ForegroundColor="#D4AF37"
    TitleColor="#F0F4F8"
    UnselectedColor="#64748B"
    Shell.BackgroundColor="#080C14"
    Shell.ForegroundColor="#D4AF37"
    Shell.TitleColor="#F0F4F8"
    Shell.UnselectedColor="#64748B">

    <TabBar BackgroundColor="#0B0F19">
        <Tab Title="Campus Hub">
            <ShellContent
                Title="Campus Hub"
                ContentTemplate="{DataTemplate local:MainPage}"
                Route="MainPage" />
        </Tab>
    </TabBar>

</Shell>
